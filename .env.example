# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Firebase ─────────────────────────────────────────────────────────────────
# Path to your Firebase service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# ─── DeepSeek ─────────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ─── Redis ────────────────────────────────────────────────────────────────────
# Local:   redis://localhost:6379
# Upstash: rediss://:password@host:port
REDIS_URL=redis://localhost:6379

# ─── Scraper ──────────────────────────────────────────────────────────────────
# Maximum markdown characters passed to DeepSeek per page
MAX_MARKDOWN_CHARS=50000

# Playwright navigation timeout in milliseconds
PLAYWRIGHT_TIMEOUT_MS=30000

# ─── Worker ───────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=2

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ─── Admin ────────────────────────────────────────────────────────────────────
# Master key for /api/admin/* and /admin panel — keep secret
ADMIN_TOKEN=your-secret-admin-token-here
